  "keyFeatures": [
    "S3-compatible API with full AWS S3 compatibility",
    "Erasure coding with Reed-Solomon algorithm for data protection",
    "Distributed multi-node, multi-drive deployments",
    "BitRot protection via HighwayHash checksums",
    "Server-side encryption with KMS integration",
    "IAM with LDAP, OpenID Connect, and built-in identity management",
    "Bucket replication and site-level replication",
    "Object lifecycle management and tiering",
    "Prometheus metrics and Grafana integration",
    "FTP/SFTP protocol support",
    "Kubernetes and Helm chart deployment",
    "Batch job processing for replication, expiration, and key rotation"
  ],
  "publicApiSurface": [
    "S3 API: PutObject, GetObject, DeleteObject, ListObjects, CreateBucket, DeleteBucket",
    "S3 API: Multipart upload (CreateMultipartUpload, UploadPart, CompleteMultipartUpload)",
    "S3 API: Presigned URLs (PutObject, GetObject)",
    "S3 API: Bucket versioning, lifecycle, replication, encryption, notification",
    "Admin API: /minio/health/live, /minio/health/ready, /minio/health/cluster",
    "Admin API: /minio/admin/v3/info, /minio/admin/v3/heal",
    "Admin API: /minio/admin/v3/add-user, /minio/admin/v3/list-users",
    "Admin API: /minio/admin/v3/add-canned-policy, /minio/admin/v3/set-user-or-group-policy",
    "STS API: AssumeRole, AssumeRoleWithWebIdentity, AssumeRoleWithLDAPIdentity",
    "Metrics: /minio/v2/metrics/cluster, /minio/v2/metrics/node",
    "Object Lambda: custom transformation via webhook handlers"
  ]
}
